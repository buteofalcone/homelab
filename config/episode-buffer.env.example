# Root-only runtime configuration for the Jellyfin/Sonarr rolling episode buffer.
JELLYFIN_API_KEY=replace-me
JELLYFIN_USERNAME=replace-me
EPISODE_BUFFER_DRY_RUN=true
EPISODE_BUFFER_SIZE=3
EPISODE_BUFFER_GRACE_HOURS=24
EPISODE_BUFFER_RECYCLE_DAYS=7
EPISODE_BUFFER_MANAGED_TAG=rolling-3
EPISODE_BUFFER_KEEP_TAG=keep
