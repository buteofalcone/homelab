[Unit]
Description=Collect HPServer dashboard status
After=docker.service tailscaled.service local-fs.target
RequiresMountsFor=/srv/storage

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/hp-dashboard-collector --output /run/hp-dashboard/status.json --group hp-dashboard
User=root
Group=root
UMask=0027
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/run/hp-dashboard
NoNewPrivileges=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_READ_SEARCH CAP_SYS_RAWIO
