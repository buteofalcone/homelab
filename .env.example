TZ=Europe/Madrid
PUID=1000
PGID=1000

# LAN address of the HP server.
SERVER_IP=192.168.1.130

# Public domain used over the private Tailscale network. Public DNS records
# point at the server's Tailscale IP and stay DNS-only (not proxied).
BASE_DOMAIN=butenko.online

HOMEPAGE_PORT=3000
PORTAINER_PORT=9443
BESZEL_PORT=8090
UPTIME_KUMA_PORT=3001
NEXTCLOUD_PORT=8082
IMMICH_PORT=2283
JELLYFIN_PORT=8096
OPEN_WEBUI_PORT=3002

# Media automation Web UIs are reachable only through Caddy.
MEDIA_ADMIN_USER=butenko

# Calibre is reachable only through Caddy. The administration password is
# stored separately in /etc/homelab/calibre-gui-password.
CALIBRE_ADMIN_USER=butenko

CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Beszel agent is enabled separately after the Hub provides a key and token.
BESZEL_AGENT_KEY=replace-after-creating-system-in-beszel
BESZEL_AGENT_TOKEN=replace-after-creating-token-in-beszel

# Nextcloud: major version is pinned. Upgrade one major version at a time.
NEXTCLOUD_IMAGE=nextcloud:33-apache
NEXTCLOUD_ADMIN_USER=butenko
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_NEXTCLOUD_ADMIN_PASSWORD
NEXTCLOUD_DB_PASSWORD=CHANGE_ME_NEXTCLOUD_DB_PASSWORD
NEXTCLOUD_REDIS_PASSWORD=CHANGE_ME_NEXTCLOUD_REDIS_PASSWORD

# Immich follows the official release channel. Read release notes before upgrades.
IMMICH_VERSION=v3.0.3
IMMICH_DB_IMAGE=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23
IMMICH_DB_PASSWORD=CHANGE_ME_IMMICH_DB_PASSWORD

# Jellyfin major version is pinned.
JELLYFIN_IMAGE=jellyfin/jellyfin:10
# Numeric host group that owns /dev/dri/renderD128. bootstrap.sh discovers it.
JELLYFIN_RENDER_GID=990

# Open WebUI is pinned because it stores mutable application state.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.0@sha256:72c0ba641ba75e7aa52655cb242570906ececd09b1140fb736483038a22b3228

# Full Calibre 9.11 image, pinned by digest.
CALIBRE_IMAGE=lscr.io/linuxserver/calibre@sha256:1e9d545e20af654af9aca439a54cdd3988cf067f64efcd409cc2bc053aeb6d15

# Stable LinuxServer images pinned by multi-platform digest.
QBITTORRENT_IMAGE=lscr.io/linuxserver/qbittorrent@sha256:b024436f8ca665d16d9a997d26fd27fdf867ee5566ba09f32764e7b2976d3e02
SONARR_IMAGE=lscr.io/linuxserver/sonarr@sha256:24acea2956a0ccb11f103877d9f4f8576600fb34bff34820ed749c2256dab89f
PROWLARR_IMAGE=lscr.io/linuxserver/prowlarr@sha256:2f3d31307beba3ba2dd226d191f5f5c14ee3b4d8b49277c64683f5ed97083179
RADARR_IMAGE=lscr.io/linuxserver/radarr@sha256:e35056574cdc695a9ee745aa1ecda9eab3842450bf4b7b8471b023790fa3861d
SEERR_IMAGE=ghcr.io/seerr-team/seerr:v3.2.0@sha256:c4cbd5121236ac2f70a843a0b920b68a27976be57917555f1c45b08a1e6b2aad

# Temporary safety floor for downloads on the current disk. This policy is
# independent of disk size and can be adjusted after the storage migration.
MEDIA_MIN_FREE_GB=80

# Conservative test limits for the temporary 500 GB HDD. Increase these
# values after migrating /srv/storage to the final 8-16 TB disk.
TIMEMACHINE_A1502_MAX_SIZE=100G
TIMEMACHINE_A1466_MAX_SIZE=100G

# Restic paths used by host-side backup scripts.
RESTIC_REPOSITORY=/srv/storage/backups/restic
RESTIC_PASSWORD_FILE=/etc/homelab/restic-password
RESTIC_CHECK_SUBSET=5%
