TZ=Europe/Madrid
PUID=1000
PGID=1000

# LAN address of the HP server.
SERVER_IP=192.168.1.130

# Local DNS suffix used by Caddy. Add these names to your router DNS,
# Pi-hole/AdGuard Home, or client hosts files.
BASE_DOMAIN=home.arpa

HOMEPAGE_PORT=3000
PORTAINER_PORT=9443
BESZEL_PORT=8090
UPTIME_KUMA_PORT=3001
NEXTCLOUD_PORT=8080
IMMICH_PORT=2283
JELLYFIN_PORT=8096

CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Beszel agent is enabled separately after the Hub provides a key and token.
BESZEL_AGENT_KEY=replace-after-creating-system-in-beszel
BESZEL_AGENT_TOKEN=replace-after-creating-token-in-beszel

# Nextcloud: major version is pinned. Upgrade one major version at a time.
NEXTCLOUD_IMAGE=nextcloud:33-apache
NEXTCLOUD_ADMIN_USER=butenko
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_NEXTCLOUD_ADMIN_PASSWORD
NEXTCLOUD_DB_PASSWORD=CHANGE_ME_NEXTCLOUD_DB_PASSWORD
NEXTCLOUD_REDIS_PASSWORD=CHANGE_ME_NEXTCLOUD_REDIS_PASSWORD

# Immich follows the official release channel. Read release notes before upgrades.
IMMICH_VERSION=release
IMMICH_DB_PASSWORD=CHANGE_ME_IMMICH_DB_PASSWORD

# Jellyfin major version is pinned.
JELLYFIN_IMAGE=jellyfin/jellyfin:10

# Restic paths used by host-side backup scripts.
RESTIC_REPOSITORY=/srv/storage/backups/restic
RESTIC_PASSWORD_FILE=/etc/homelab/restic-password
RESTIC_CHECK_SUBSET=5%
