TZ=Europe/Madrid
PUID=1000
PGID=1000

# Current LAN address of the server.
SERVER_IP=192.168.1.130

HOMEPAGE_PORT=3000
PORTAINER_PORT=9443
BESZEL_PORT=8090
UPTIME_KUMA_PORT=3001

# Beszel agent is enabled separately after the Hub gives you a key/token.
BESZEL_AGENT_KEY=replace-after-creating-system-in-beszel
BESZEL_AGENT_TOKEN=replace-after-creating-token-in-beszel

# Restic paths used by host-side backup scripts.
RESTIC_REPOSITORY=/srv/storage/backups/restic
RESTIC_PASSWORD_FILE=/etc/homelab/restic-password
